# ECFC private Guess Song audio gateway example.
#
# This is a deployment template, not a live configuration. The real media
# server already has its media.ecfc.fans HTTPS server block and public /media/
# proxy. Add the sections below to that existing configuration; do not create
# a second server block and do not remove or replace /media/.
#
# The media server must have the auth_request module enabled.

# -----------------------------------------------------------------------------
# 1. Add inside the existing http {} context.
# -----------------------------------------------------------------------------

# proxy_cache_path /var/cache/nginx/ecfc-guess-song-audio
#     levels=1:2
#     keys_zone=ecfc_guess_song_audio:32m
#     max_size=8g
#     inactive=30m
#     use_temp_path=off;

# This access log deliberately contains no request URI, args, ticket,
# requestKey, Authorization, or Cookie.
# log_format ecfc_media_private '$remote_addr $request_method $uri '
#     '$status $upstream_cache_status $body_bytes_sent '
#     'range="$http_range"';

# -----------------------------------------------------------------------------
# 2. Add inside the existing media.ecfc.fans HTTPS server {}.
#
# Keep the existing TLS directives and public /media/ location unchanged.
# -----------------------------------------------------------------------------

include /etc/nginx/private/ecfc-media-gateway-secret.conf;

location ~ ^/private/guess-song/(?<guess_song_session>[^/]+)/(?<guess_song_question>[^/]+)$ {
    # Freeze the named captures before any rewrite or auth subrequest can
    # change the request URI and its regex capture state.
    set $guess_song_media_session $guess_song_session;
    set $guess_song_media_question $guess_song_question;

    # Only the media methods are accepted. proxy_cache_methods alone does not
    # reject other methods, so reject them explicitly before authentication.
    if ($request_method !~ ^(?:GET|HEAD)$) {
        return 405;
    }

    # Snapshot browser query credentials before rewrite replaces the query
    # string with an internal application URI. They are forwarded as headers,
    # never as part of the upstream URI.
    set $guess_song_media_request_key $arg_requestKey;
    set $guess_song_media_ticket $arg_ticket;
    rewrite ^ /api/internal/media/guess-song/origin? break;

    # auth_request runs in the access phase before proxy cache lookup, including
    # on requests that would otherwise be served from cache.
    auth_request /_ecfc_guess_song_media_auth;
    auth_request_set $guess_song_cache_key $upstream_http_x_media_cache_key;

    proxy_cache ecfc_guess_song_audio;
    # Only the server-generated hash returned by authorize identifies the
    # object. ticket, user ID, requestKey, and COS signatures are excluded.
    proxy_cache_key "$scheme|$host|guess-song|$guess_song_cache_key";
    proxy_cache_methods GET HEAD;
    proxy_cache_bypass $http_range;
    proxy_no_cache $http_range;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 10s;
    proxy_cache_revalidate on;
    proxy_cache_valid 200 10m;

    # First phase: pass Range through to the application origin and bypass
    # cache for every Range request. Slice cache is intentionally disabled.
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;

    proxy_http_version 1.1;
    proxy_set_header Host ecfc.fans;
    proxy_set_header X-Forwarded-Host media.ecfc.fans;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-ECFC-Media-Gateway $media_gateway_secret;
    proxy_set_header X-ECFC-Media-Session-Id $guess_song_media_session;
    proxy_set_header X-ECFC-Media-Question-Id $guess_song_media_question;
    proxy_set_header X-ECFC-Media-Request-Key $guess_song_media_request_key;
    proxy_set_header X-ECFC-Media-Ticket $guess_song_media_ticket;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header Accept-Encoding "";

    proxy_ssl_server_name on;
    proxy_ssl_name ecfc.fans;
    # Static hostname: resolved when nginx loads/reloads, not at request time.
    proxy_pass https://ecfc.fans;

    # Keep real upstream errors available without enabling noisy warn/info
    # logging. Nginx error messages may still include request details; never
    # enable debug logging for this location.
    error_log /var/log/nginx/ecfc-media-private-audio.error.log error;

    # The internal origin is reachable only behind this authenticated
    # location. Do not allow browsers to retain or share private audio.
    proxy_hide_header Cache-Control;
    add_header Cache-Control "private, no-store" always;
    add_header X-Cache-Status $upstream_cache_status always;
    access_log /var/log/nginx/ecfc-media-private-audio.access.log ecfc_media_private;
}

location = /_ecfc_guess_song_media_auth {
    internal;

    # The trailing ? discards the browser query string. All binding values are
    # sent as headers, and the application route still revalidates them.
    rewrite ^ /api/internal/media/guess-song/authorize? break;
    proxy_pass https://ecfc.fans;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host ecfc.fans;
    proxy_set_header X-Forwarded-Host media.ecfc.fans;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-ECFC-Media-Session-Id $guess_song_media_session;
    proxy_set_header X-ECFC-Media-Question-Id $guess_song_media_question;
    proxy_set_header X-ECFC-Media-Request-Key $guess_song_media_request_key;
    proxy_set_header X-ECFC-Media-Ticket $guess_song_media_ticket;
    proxy_set_header X-ECFC-Media-Gateway "";
    proxy_ssl_server_name on;
    proxy_ssl_name ecfc.fans;
    access_log off;
    error_log /var/log/nginx/ecfc-media-private-audio.error.log error;
}

# -----------------------------------------------------------------------------
# 3. Secret include file example.
#
# File: /etc/nginx/private/ecfc-media-gateway-secret.conf
# Directory permissions: 700 root:root
# File permissions:      600 root:root
#
# The value below is only a placeholder. Replace it during deployment with the
# same MEDIA_GATEWAY_SECRET value used by the application server. Never place
# COS credentials on the media server.
# -----------------------------------------------------------------------------

# set $media_gateway_secret 'replace-at-deploy-time';
