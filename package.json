{
  "name": "eason-fans-club",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "dev:8000": "next dev -p 8000",
    "build": "next build",
    "start": "next start",
    "start:8000": "next start -p 8000",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cloudflare:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cloudflare:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cloudflare:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "test:account-security": "tsx --test tests/account-security.test.ts tests/account-recovery-permissions.test.ts",
    "test:consistency": "tsx --test tests/forum-layout-feedback-checkin.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "checkin:recalculate": "tsx scripts/recalculate-checkin-stats.ts",
    "checkin:audit-duplicates": "tsx scripts/audit-checkin-duplicates.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^5.9.6",
    "next": "^15.0.0",
    "pg": "^8.16.3",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.3",
    "react-resizable": "^4.0.2",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.110.0"
  }
}
