# Include this alongside the existing access_log; do not replace or delete the
# current format. It intentionally omits query strings to avoid logging tokens
# or other sensitive parameters.
map $uri $ecfc_api_perf_enabled {
    default 0;
    ~^/api/ 1;
    ~^/ws(?:/|$) 1;
    ~^/fallback(?:/|$) 1;
}

log_format ecfc_api_perf escape=json
    '{"time":"$time_iso8601",'
    '"request_id":"$http_x_request_id",'
    '"method":"$request_method",'
    '"uri":"$uri",'
    '"status":$status,'
    '"request_time":$request_time,'
    '"upstream_response_time":"$upstream_response_time",'
    '"upstream_status":"$upstream_status",'
    '"bytes_sent":$bytes_sent,'
    '"connection":"$connection"}';

access_log /var/log/nginx/access_perf.log ecfc_api_perf if=$ecfc_api_perf_enabled;
