generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("MIGRATION_MYSQL_URL")
}

model User {
  id                              String                      @id @default(cuid())
  username                        String
  email                           String?
  phone                           String?
  passwordHash                    String
  nickname                        String
  avatarUrl                       String?
  bio                             String?
  role                            UserRole                    @default(USER)
  level                           Int                         @default(1)
  points                          Int                         @default(0)
  consecutiveDays                 Int                         @default(0)
  lastCheckInDate                 DateTime?
  isDeleted                       Boolean                     @default(false)
  deletedAt                       DateTime?
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  backgroundUrl                   String?
  emailVerifiedAt                 DateTime?
  exp                             Int                         @default(0)
  isOnline                        Boolean                     @default(false)
  lastActiveAt                    DateTime?
  lastLoginAt                     DateTime?
  phoneVerifiedAt                 DateTime?
  status                          UserStatus                  @default(ACTIVE)
  verificationStatus              VerificationStatus          @default(NONE)
  nicknameChangedAt               DateTime?
  uid                             Int                         @unique @default(autoincrement())
  experience                      Int                         @default(0)
  securityQuestionRecoveryEnabled Boolean                     @default(false)
  registrationIdempotencyKeyHash  String?                     @unique
  mustSetupSecurity               Boolean                     @default(false)
  usernameNormalized              String                      @unique
  checkinMoodEnabled              Boolean                     @default(true)
  securityLogs                    AccountSecurityLog[]
  activityFavorites               ActivityFavorite[]
  activityRegistrations           ActivityRegistration[]
  adminActions                    AdminAction[]               @relation("AdminOperator")
  targetAdminActions              AdminAction[]               @relation("AdminTargetUser")
  administeredActionLogs          AdminActionLog[]            @relation("AdminActionLogAdmin")
  targetedActionLogs              AdminActionLog[]            @relation("AdminActionLogTarget")
  adminPermissions                AdminPermission[]
  blockedBy                       Block[]                     @relation("Blocked")
  blocksMade                      Block[]                     @relation("Blocker")
  boardFavorites                  BoardFavorite[]
  createdChangelogs               Changelog[]                 @relation("ChangelogCreator")
  checkIns                        CheckIn[]
  conversations                   ConversationParticipant[]
  cultureComments                 CultureComment[]
  cultureFavorites                CultureFavorite[]
  dailyExperienceRecords          DailyExperienceRecord[]
  dailyMessages                   DailyMessage[]
  dailyMessageComments            DailyMessageComment[]
  dailyMessageFavorites           DailyMessageFavorite[]
  dailyMessageLikes               DailyMessageLike[]
  dailyTaskProgress               DailyTaskProgress[]
  messages                        DirectMessage[]
  emailVerifications              EmailVerification[]
  entertainmentDailyDraws         EntertainmentDailyDraw[]
  experienceLogs                  ExperienceLog[]
  feedbacks                       Feedback[]
  feedbackReplies                 FeedbackReply[]
  following                       Follow[]                    @relation("FollowFollower")
  followers                       Follow[]                    @relation("FollowFollowing")
  friendActivities                FriendActivity[]            @relation("FriendActivityActor")
  receivedFriendRequests          FriendRequest[]             @relation("FriendRequestReceiver")
  sentFriendRequests              FriendRequest[]             @relation("FriendRequestSender")
  friendshipsA                    Friendship[]                @relation("FriendshipUserA")
  friendshipsB                    Friendship[]                @relation("FriendshipUserB")
  guessSongLeaderboardEntries     GuessSongLeaderboardEntry[]
  guessSongSessions               GuessSongSession[]
  likes                           Like[]
  devices                         LoginDevice[]
  lotteryEntries                  LotteryEntry[]
  lyricCards                      LyricCard[]
  musicFavorites                  MusicFavorite[]
  musicPlayRecords                MusicPlayRecord[]
  sentNotifications               Notification[]              @relation("NotificationActor")
  notifications                   Notification[]              @relation("NotificationRecipient")
  onlineSessions                  OnlineSession[]
  publishedPageLayouts            PageLayout[]                @relation("PageLayoutPublishedBy")
  updatedPageLayouts              PageLayout[]                @relation("PageLayoutUpdatedBy")
  pageLayoutRevisions             PageLayoutRevision[]        @relation("PageLayoutRevisionPublisher")
  passwordResets                  PasswordResetToken[]
  pointLogs                       PointLog[]
  posts                           Post[]
  favorites                       PostFavorite[]
  profile                         Profile?
  profileWallLikes                ProfileWallLike[]
  profileWallMessagesReceived     ProfileWallMessage[]        @relation("ProfileWallReceiver")
  profileWallMessagesSent         ProfileWallMessage[]        @relation("ProfileWallSender")
  replies                         Reply[]
  replyLikes                      ReplyLike[]
  replyMentionsCreated            ReplyMention[]              @relation("ReplyMentionMentioner")
  replyMentionsReceived           ReplyMention[]              @relation("ReplyMentionMentionedUser")
  reports                         Report[]                    @relation("Reporter")
  reportedReports                 Report[]                    @relation("ReportedUser")
  searchHistory                   SearchHistory[]
  createdSystemNotifications      SystemNotification[]        @relation("SystemNotificationCreator")
  systemNotificationReads         SystemNotificationRead[]
  achievements                    UserAchievement[]
  albumCollections                UserAlbumCollection[]
  badges                          UserBadge[]
  securityQuestions               UserSecurityQuestion?

  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@index([uid])
  @@index([username])
  @@index([phone])
  @@index([email])
  @@index([points])
  @@index([level])
  @@index([experience])
  @@index([lastActiveAt])
  @@index([createdAt])
}

model Profile {
  id             String                @id @default(cuid())
  displayName    String
  avatarUrl      String?
  backgroundUrl  String?
  bio            String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  userId         String                @unique
  wallVisibility ProfileWallVisibility @default(PUBLIC)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@index([wallVisibility])
}

model ProfileWallMessage {
  id         String               @id @default(cuid())
  content    String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  deletedAt  DateTime?
  senderId   String
  receiverId String
  parentId   String?
  likeCount  Int                  @default(0)
  likes      ProfileWallLike[]
  parent     ProfileWallMessage?  @relation("ProfileWallThread", fields: [parentId], references: [id], onDelete: NoAction)
  children   ProfileWallMessage[] @relation("ProfileWallThread")
  receiver   User                 @relation("ProfileWallReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User                 @relation("ProfileWallSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId, createdAt])
  @@index([senderId, createdAt])
  @@index([parentId])
  @@index([deletedAt])
}

model ProfileWallLike {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  messageId String
  userId    String
  message   ProfileWallMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model BoardCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  boards      Board[]

  @@index([sortOrder])
}

model Board {
  id            String          @id @default(cuid())
  name          String          @unique
  slug          String          @unique
  description   String?
  sortOrder     Int             @default(0)
  postCount     Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  categoryId    String?
  coverUrl      String?
  followerCount Int             @default(0)
  isHot         Boolean         @default(false)
  isRecommended Boolean         @default(false)
  parentId      String?
  adminActions  AdminAction[]
  category      BoardCategory?  @relation(fields: [categoryId], references: [id])
  parent        Board?          @relation("BoardTree", fields: [parentId], references: [id])
  children      Board[]         @relation("BoardTree")
  favorites     BoardFavorite[]
  posts         Post[]

  @@index([categoryId])
  @@index([parentId])
  @@index([sortOrder])
  @@index([isActive])
  @@index([isHot])
  @@index([isRecommended])
}

model Post {
  id            String          @id @default(cuid())
  title         String
  content       String
  viewCount     Int             @default(0)
  likeCount     Int             @default(0)
  replyCount    Int             @default(0)
  isPinned      Boolean         @default(false)
  isFeatured    Boolean         @default(false)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  authorId      String
  boardId       String
  contentType   PostContentType @default(NORMAL)
  favoriteCount Int             @default(0)
  isLocked      Boolean         @default(false)
  isRecommended Boolean         @default(false)
  publishedAt   DateTime        @default(now())
  readUserCount Int             @default(0)
  shareCount    Int             @default(0)
  status        PostStatus      @default(PUBLISHED)
  summary       String?
  adminActions  AdminAction[]
  likes         Like[]
  poll          Poll?
  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  board         Board           @relation(fields: [boardId], references: [id])
  favorites     PostFavorite[]
  media         PostMedia[]
  tags          PostTag[]
  replies       Reply[]
  reports       Report[]

  @@index([boardId, createdAt])
  @@index([authorId, createdAt])
  @@index([status])
  @@index([contentType])
  @@index([isPinned, createdAt])
  @@index([isFeatured, createdAt])
  @@index([isRecommended, createdAt])
  @@index([isDeleted])
  @@index([likeCount])
  @@index([replyCount])
  @@index([boardId, status, isDeleted, isPinned, isFeatured, createdAt], map: "Post_board_feed_idx")
  @@index([status, isDeleted, isPinned, isFeatured, createdAt], map: "Post_global_feed_idx")
  @@index([status, isDeleted, isPinned, isFeatured, likeCount, replyCount], map: "Post_hot_feed_idx")
  @@index([status, isDeleted, createdAt], map: "Post_trending_window_idx")
}

model Reply {
  id           String        @id @default(cuid())
  content      String
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  postId       String
  authorId     String
  parentId     String?
  likeCount    Int           @default(0)
  adminActions AdminAction[]
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent       Reply?        @relation("ReplyThread", fields: [parentId], references: [id], onDelete: NoAction)
  children     Reply[]       @relation("ReplyThread")
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes        ReplyLike[]
  mentions     ReplyMention[]
  reports      Report[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
  @@index([isDeleted])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
}

model ReplyLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  replyId   String
  userId    String
  reply     Reply    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([userId, createdAt])
  @@index([replyId, createdAt])
}

model ReplyMention {
  id              String   @id @default(cuid())
  replyId         String
  mentionerId     String
  mentionedUserId String
  startIndex      Int
  endIndex        Int
  displayText     String
  createdAt       DateTime @default(now())
  reply           Reply    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  mentioner       User     @relation("ReplyMentionMentioner", fields: [mentionerId], references: [id], onDelete: Cascade)
  mentionedUser   User     @relation("ReplyMentionMentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([replyId, mentionedUserId])
  @@index([mentionerId, createdAt])
  @@index([mentionedUserId, createdAt])
}

model PostFavorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model BoardFavorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  boardId   String
  userId    String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId, createdAt])
}

model Tag {
  id         String    @id @default(cuid())
  name       String    @unique
  slug       String    @unique
  usageCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  posts      PostTag[]

  @@index([usageCount])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model PostMedia {
  id        String    @id @default(cuid())
  type      MediaType
  url       String
  thumbnail String?
  width     Int?
  height    Int?
  size      Int?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model Poll {
  id         String       @id @default(cuid())
  question   String
  allowMulti Boolean      @default(false)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  postId     String       @unique
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options    PollOption[]
  votes      PollVote[]
}

model PollOption {
  id        String     @id @default(cuid())
  title     String
  voteCount Int        @default(0)
  sortOrder Int        @default(0)
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([pollId, sortOrder])
}

model PollVote {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  pollId    String
  optionId  String
  userId    String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

model CheckIn {
  id               String           @id @default(cuid())
  checkDate        DateTime
  points           Int              @default(10)
  streakDay        Int              @default(1)
  createdAt        DateTime         @default(now())
  userId           String
  isMakeUp         Boolean          @default(false)
  exp              Int              @default(0)
  message          String?
  mood             String?
  checkinDateKey   String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyMessage     DailyMessage?
  friendActivities FriendActivity[]

  @@unique([userId, checkDate])
  @@unique([userId, checkinDateKey])
  @@index([checkDate])
  @@index([userId, createdAt])
}

model DailyMessage {
  id               String                 @id @default(cuid())
  date             DateTime
  mood             String?
  content          String
  likeCount        Int                    @default(0)
  commentCount     Int                    @default(0)
  favoriteCount    Int                    @default(0)
  shareCount       Int                    @default(0)
  isPinned         Boolean                @default(false)
  isFeatured       Boolean                @default(false)
  isDeleted        Boolean                @default(false)
  deletedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  userId           String
  checkInId        String?                @unique
  checkIn          CheckIn?               @relation(fields: [checkInId], references: [id])
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments         DailyMessageComment[]
  favorites        DailyMessageFavorite[]
  likes            DailyMessageLike[]
  friendActivities FriendActivity[]
  reports          Report[]

  @@index([date, createdAt])
  @@index([date, likeCount])
  @@index([userId, createdAt])
  @@index([isPinned, isFeatured])
  @@index([isDeleted])
  @@index([date, isDeleted, isPinned, isFeatured, likeCount, commentCount, createdAt], map: "DailyMessage_hot_idx")
  @@index([date, isDeleted, isPinned, isFeatured, createdAt], map: "DailyMessage_latest_idx")
}

model FriendActivity {
  id             String        @id @default(cuid())
  mood           String?
  content        String?
  createdAt      DateTime      @default(now())
  actorId        String
  checkInId      String?
  dailyMessageId String?
  type           String        @default("CHECKIN")
  targetUrl      String?
  actor          User          @relation("FriendActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  checkIn        CheckIn?      @relation(fields: [checkInId], references: [id])
  dailyMessage   DailyMessage? @relation(fields: [dailyMessageId], references: [id])

  @@index([actorId, createdAt])
  @@index([checkInId])
  @@index([dailyMessageId])
}

model GrowthLevelConfig {
  id          String   @id @default(cuid())
  level       Int      @unique
  name        String
  requiredExp Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requiredExp])
}

model ExperienceLog {
  id          String            @id @default(cuid())
  amount      Int
  type        ExperienceLogType
  description String
  createdAt   DateTime          @default(now())
  userId      String
  sourceType  String?
  sourceId    String?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model DailyExperienceRecord {
  id        String   @id @default(cuid())
  date      DateTime
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model Task {
  id          String   @id @default(cuid())
  name        String
  description String?
  expReward   Int
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([createdAt])
}

model DailyMessageLike {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  messageId String
  userId    String
  message   DailyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model DailyMessageFavorite {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  messageId String
  userId    String
  message   DailyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model DailyMessageComment {
  id        String                @id @default(cuid())
  content   String
  isDeleted Boolean               @default(false)
  deletedAt DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  messageId String
  authorId  String
  parentId  String?
  author    User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  message   DailyMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  parent    DailyMessageComment?  @relation("DailyMessageCommentThread", fields: [parentId], references: [id], onDelete: NoAction)
  children  DailyMessageComment[] @relation("DailyMessageCommentThread")

  @@index([messageId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model DailyTaskTemplate {
  id          String              @id @default(cuid())
  key         String              @unique
  title       String
  description String?
  target      Int                 @default(1)
  points      Int                 @default(0)
  exp         Int                 @default(0)
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  progress    DailyTaskProgress[]

  @@index([isActive, sortOrder])
}

model DailyTaskProgress {
  id          String            @id @default(cuid())
  taskDate    DateTime
  progress    Int               @default(0)
  isCompleted Boolean           @default(false)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  userId      String
  templateId  String
  template    DailyTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId, taskDate])
  @@index([taskDate, isCompleted])
}

model PointLog {
  id          String                  @id @default(cuid())
  action      PointActionType
  points      Int
  before      Int
  after       Int
  reason      String?
  createdAt   DateTime                @default(now())
  userId      String
  postId      String?
  replyId     String?
  checkInId   String?
  activityId  String?
  badgeId     String?
  dailyDrawId String?                 @unique
  dateKey     String?
  businessKey String?                 @unique
  dailyDraw   EntertainmentDailyDraw? @relation(fields: [dailyDrawId], references: [id])
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([action, checkInId])
  @@index([userId, createdAt])
  @@index([action])
  @@index([postId])
  @@index([replyId])
  @@index([checkInId])
  @@index([activityId])
}

model LyricPrescription {
  id           String                   @id @default(cuid())
  text         String
  songTitle    String
  albumTitle   String?
  enabled      Boolean                  @default(true)
  displayCount Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  dailyDraws   EntertainmentDailyDraw[]

  @@index([enabled, createdAt])
  @@index([displayCount])
}

model EntertainmentDailyDraw {
  id                  String             @id @default(cuid())
  dateKey             String
  points              Int
  prescriptionCode    String             @unique
  lyricText           String?
  songTitle           String?
  albumTitle          String?
  createdAt           DateTime           @default(now())
  userId              String
  lyricPrescriptionId String?
  lyricPrescription   LyricPrescription? @relation(fields: [lyricPrescriptionId], references: [id], onDelete: Restrict)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointLog            PointLog?

  @@unique([userId, dateKey])
  @@index([userId])
  @@index([dateKey])
  @@index([lyricPrescriptionId])
  @@index([userId, createdAt])
}

model GuessSongQuestion {
  id               String                     @id @default(cuid())
  songTitle        String
  albumTitle       String?
  difficulty       GuessSongDifficulty
  enabled          Boolean                    @default(false)
  allowEndless     Boolean                    @default(true)
  correctAnswer    String
  wrongOption1     String
  wrongOption2     String
  wrongOption3     String
  sourceAudioPath  String?
  audioDurationMs  Int?
  processingStatus GuessSongProcessingStatus  @default(PENDING)
  processingError  String?
  playCount        Int                        @default(0)
  answerCount      Int                        @default(0)
  correctCount     Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  musicSongId      String?
  audioVariants    GuessSongAudioVariant[]
  musicSong        MusicSong?                 @relation(fields: [musicSongId], references: [id])
  sessionQuestions GuessSongSessionQuestion[]

  @@index([difficulty, enabled])
  @@index([allowEndless, enabled])
  @@index([processingStatus])
  @@index([songTitle])
  @@index([musicSongId])
  @@index([createdAt])
}

model GuessSongAudioVariant {
  id              String                 @id @default(cuid())
  durationSeconds Int
  storagePath     String
  fileSize        Int
  createdAt       DateTime               @default(now())
  questionId      String
  question        GuessSongQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  playRequests    GuessSongPlayRequest[]

  @@unique([questionId, durationSeconds])
  @@index([questionId])
}

model GuessSongSession {
  id                 String                      @id @default(cuid())
  activeKey          String?                     @unique
  mode               GuessSongMode
  status             GuessSongSessionStatus      @default(IN_PROGRESS)
  score              Int                         @default(0)
  correctCount       Int                         @default(0)
  wrongCount         Int                         @default(0)
  currentStreak      Int                         @default(0)
