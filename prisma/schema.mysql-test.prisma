  targetUser   User     @relation("AdminActionLogTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model AdminPermission {
  id            String   @id @default(cuid())
  permissionKey String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([permissionKey, enabled])
  @@index([userId, enabled])
}

model Achievement {
  id             String              @id @default(cuid())
  title          String
  slug           String              @unique
  description    String?
  icon           String?
  imageUrl       String?
  color          String?
  category       AchievementCategory
  rarity         AchievementRarity   @default(NORMAL)
  conditionKey   String?
  conditionValue Int?
  isAutoGrant    Boolean             @default(true)
  isVisible      Boolean             @default(true)
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  users          UserAchievement[]

  @@index([category, sortOrder])
  @@index([isVisible])
  @@index([rarity])
}

model UserAchievement {
  id            String      @id @default(cuid())
  progress      Int         @default(0)
  unlocked      Boolean     @default(false)
  unlockedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userId        String
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlocked])
  @@index([achievementId])
}

model DailyQuote {
  id        String   @id @default(cuid())
  content   String
  source    String?
  songTitle String?
  isPinned  Boolean  @default(false)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPinned, isVisible])
  @@index([sortOrder])
}

model CultureItem {
  id               String                @id @default(cuid())
  type             CultureContentType
  title            String
  slug             String                @unique
  subtitle         String?
  coverUrl         String?
  releaseDate      DateTime?
  lyricist         String?
  composer         String?
  arranger         String?
  albumName        String?
  roleName         String?
  city             String?
  summary          String?
  background       String?
  legalExcerpt     String?
  mvUrl            String?
  liveUrl          String?
  trailerUrl       String?
  rating           Float?
  favoriteCount    Int                   @default(0)
  commentCount     Int                   @default(0)
  isVisible        Boolean               @default(true)
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  comments         CultureComment[]
  favorites        CultureFavorite[]
  lyricCards       LyricCard[]
  albumCollections UserAlbumCollection[] @relation("AlbumCollectionItem")

  @@index([type, isVisible, sortOrder])
  @@index([releaseDate])
}

model CultureComment {
  id        String      @id @default(cuid())
  content   String
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  itemId    String
  userId    String
  item      CultureItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([userId, createdAt])
}

model CultureFavorite {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  itemId    String
  userId    String
  item      CultureItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId, createdAt])
}

model UserAlbumCollection {
  id        String      @id @default(cuid())
  owned     Boolean     @default(true)
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  albumId   String
  album     CultureItem @relation("AlbumCollectionItem", fields: [albumId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([userId, owned])
}

model LyricCardTemplate {
  id            String      @id @default(cuid())
  name          String
  backgroundUrl String?
  textColor     String      @default("#071722")
  accentColor   String      @default("#1985c2")
  isVisible     Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cards         LyricCard[]

  @@index([isVisible, sortOrder])
}

model LyricCard {
  id         String             @id @default(cuid())
  lyric      String
  imageUrl   String?
  isFavorite Boolean            @default(false)
  createdAt  DateTime           @default(now())
  userId     String
  songId     String?
  templateId String?
  song       CultureItem?       @relation(fields: [songId], references: [id])
  template   LyricCardTemplate? @relation(fields: [templateId], references: [id])
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([songId])
}

