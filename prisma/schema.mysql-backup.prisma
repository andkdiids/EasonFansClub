generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("MIGRATION_POSTGRES_URL")
}
model accountsecuritylog {
  id        String   @id
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "AccountSecurityLog_userId_fkey")

  @@index([action, createdAt], map: "AccountSecurityLog_action_createdAt_idx")
  @@index([userId, createdAt], map: "AccountSecurityLog_userId_createdAt_idx")
}

model achievement {
  id              String               @id
  title           String
  slug            String               @unique(map: "Achievement_slug_key")
  description     String?
  icon            String?
  imageUrl        String?
  color           String?
  category        achievement_category
  rarity          achievement_rarity   @default(NORMAL)
  conditionKey    String?
  conditionValue  Int?
  isAutoGrant     Boolean              @default(true)
  isVisible       Boolean              @default(true)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime
  userachievement userachievement[]

  @@index([category, sortOrder], map: "Achievement_category_sortOrder_idx")
  @@index([isVisible], map: "Achievement_isVisible_idx")
  @@index([rarity], map: "Achievement_rarity_idx")
}

model activity {
  id                   String                 @id
  title                String
  description          String
  type                 activity_type          @default(OTHER)
  status               activity_status        @default(DRAFT)
  coverUrl             String?
  pointsReward         Int?
  signupLimit          Int?
  signupCount          Int                    @default(0)
  startsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  activityfavorite     activityfavorite[]
  activityregistration activityregistration[]
  lottery              lottery[]

  @@index([status, createdAt], map: "Activity_status_createdAt_idx")
  @@index([status, startsAt], map: "Activity_status_startsAt_idx")
  @@index([type], map: "Activity_type_idx")
}

model activityfavorite {
  id         String   @id
  createdAt  DateTime @default(now())
  activityId String
  userId     String
  activity   activity @relation(fields: [activityId], references: [id], onDelete: Cascade, map: "ActivityFavorite_activityId_fkey")
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ActivityFavorite_userId_fkey")

  @@unique([activityId, userId], map: "ActivityFavorite_activityId_userId_key")
  @@index([userId], map: "ActivityFavorite_userId_fkey")
}

model activityregistration {
  id          String    @id
  note        String?
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())
  activityId  String
  userId      String
  activity    activity  @relation(fields: [activityId], references: [id], onDelete: Cascade, map: "ActivityRegistration_activityId_fkey")
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ActivityRegistration_userId_fkey")

  @@unique([activityId, userId], map: "ActivityRegistration_activityId_userId_key")
  @@index([userId, createdAt], map: "ActivityRegistration_userId_createdAt_idx")
}

model adminaction {
  id                                  String             @id
  action                              adminaction_action
  reason                              String?
  metadata                            Json?
  createdAt                           DateTime           @default(now())
  adminId                             String
  targetUserId                        String?
  postId                              String?
  replyId                             String?
  boardId                             String?
  user_adminaction_adminIdTouser      user               @relation("adminaction_adminIdTouser", fields: [adminId], references: [id], onDelete: Cascade, map: "AdminAction_adminId_fkey")
  board                               board?             @relation(fields: [boardId], references: [id], map: "AdminAction_boardId_fkey")
  post                                post?              @relation(fields: [postId], references: [id], map: "AdminAction_postId_fkey")
  reply                               reply?             @relation(fields: [replyId], references: [id], map: "AdminAction_replyId_fkey")
  user_adminaction_targetUserIdTouser user?              @relation("adminaction_targetUserIdTouser", fields: [targetUserId], references: [id], map: "AdminAction_targetUserId_fkey")

  @@index([action], map: "AdminAction_action_idx")
  @@index([adminId, createdAt], map: "AdminAction_adminId_createdAt_idx")
  @@index([boardId], map: "AdminAction_boardId_idx")
  @@index([postId], map: "AdminAction_postId_idx")
  @@index([replyId], map: "AdminAction_replyId_idx")
  @@index([targetUserId], map: "AdminAction_targetUserId_idx")
}

model adminactionlog {
  id                                     String   @id
  adminId                                String
  action                                 String
  targetUserId                           String
  detail                                 Json?
  createdAt                              DateTime @default(now())
  user_adminactionlog_adminIdTouser      user     @relation("adminactionlog_adminIdTouser", fields: [adminId], references: [id], onDelete: Cascade, map: "AdminActionLog_adminId_fkey")
  user_adminactionlog_targetUserIdTouser user     @relation("adminactionlog_targetUserIdTouser", fields: [targetUserId], references: [id], onDelete: Cascade, map: "AdminActionLog_targetUserId_fkey")

  @@index([action, createdAt], map: "AdminActionLog_action_createdAt_idx")
  @@index([adminId, createdAt], map: "AdminActionLog_adminId_createdAt_idx")
  @@index([targetUserId, createdAt], map: "AdminActionLog_targetUserId_createdAt_idx")
}

model adminpermission {
  id            String   @id
  permissionKey String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  userId        String
  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "AdminPermission_userId_fkey")

  @@unique([userId, permissionKey], map: "AdminPermission_userId_permissionKey_key")
  @@index([permissionKey, enabled], map: "AdminPermission_permissionKey_enabled_idx")
  @@index([userId, enabled], map: "AdminPermission_userId_enabled_idx")
}

model announcement {
  id          String   @id
  title       String
  content     String
  isPinned    Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isPublished, isPinned], map: "Announcement_isPublished_isPinned_idx")
}

model badge {
  id          String      @id
  name        String      @unique(map: "Badge_name_key")
  slug        String      @unique(map: "Badge_slug_key")
  description String?
  iconUrl     String?
  pointsCost  Int?
  isAutoGrant Boolean     @default(false)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  userbadge   userbadge[]

  @@index([isActive], map: "Badge_isActive_idx")
}

model banner {
  id        String   @id
  title     String
  imageUrl  String
  link      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([isActive, sortOrder], map: "Banner_isActive_sortOrder_idx")
}

model block {
  id                         String   @id
  reason                     String?
  createdAt                  DateTime @default(now())
  blockerId                  String
  blockedId                  String
  user_block_blockedIdTouser user     @relation("block_blockedIdTouser", fields: [blockedId], references: [id], onDelete: Cascade, map: "Block_blockedId_fkey")
  user_block_blockerIdTouser user     @relation("block_blockerIdTouser", fields: [blockerId], references: [id], onDelete: Cascade, map: "Block_blockerId_fkey")

  @@unique([blockerId, blockedId], map: "Block_blockerId_blockedId_key")
  @@index([blockedId], map: "Block_blockedId_fkey")
}

model board {
  id            String          @id
  name          String          @unique(map: "Board_name_key")
  slug          String          @unique(map: "Board_slug_key")
  description   String?
  sortOrder     Int             @default(0)
  postCount     Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  categoryId    String?
  coverUrl      String?
  followerCount Int             @default(0)
  isHot         Boolean         @default(false)
  isRecommended Boolean         @default(false)
  parentId      String?
  adminaction   adminaction[]
  boardcategory boardcategory?  @relation(fields: [categoryId], references: [id], map: "Board_categoryId_fkey")
  board         board?          @relation("boardToboard", fields: [parentId], references: [id], map: "Board_parentId_fkey")
  other_board   board[]         @relation("boardToboard")
  boardfavorite boardfavorite[]
  post          post[]

  @@index([categoryId], map: "Board_categoryId_idx")
  @@index([isActive], map: "Board_isActive_idx")
  @@index([isHot], map: "Board_isHot_idx")
  @@index([isRecommended], map: "Board_isRecommended_idx")
  @@index([parentId], map: "Board_parentId_idx")
  @@index([sortOrder], map: "Board_sortOrder_idx")
}

model boardcategory {
  id          String   @id
  name        String   @unique(map: "BoardCategory_name_key")
  slug        String   @unique(map: "BoardCategory_slug_key")
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  board       board[]

  @@index([sortOrder], map: "BoardCategory_sortOrder_idx")
}

model boardfavorite {
  id        String   @id
  createdAt DateTime @default(now())
  boardId   String
  userId    String
  board     board    @relation(fields: [boardId], references: [id], onDelete: Cascade, map: "BoardFavorite_boardId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "BoardFavorite_userId_fkey")

  @@unique([boardId, userId], map: "BoardFavorite_boardId_userId_key")
  @@index([userId, createdAt], map: "BoardFavorite_userId_createdAt_idx")
}

model changelog {
  id          String           @id
  version     String           @unique(map: "Changelog_version_key")
  major       Int
  minor       Int
  patch       Int
  title       String
  content     String
  type        changelog_type
  isMajor     Boolean          @default(false)
  status      changelog_status @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  createdById String
  user        user             @relation(fields: [createdById], references: [id], onDelete: Cascade, map: "Changelog_createdById_fkey")

  @@index([createdById, createdAt], map: "Changelog_createdById_createdAt_idx")
  @@index([major, minor, patch], map: "Changelog_major_minor_patch_idx")
  @@index([status, publishedAt], map: "Changelog_status_publishedAt_idx")
}

model checkin {
  id             String           @id
  checkDate      DateTime
  points         Int              @default(10)
  streakDay      Int              @default(1)
  createdAt      DateTime         @default(now())
  userId         String
  isMakeUp       Boolean          @default(false)
  exp            Int              @default(0)
  message        String?          @db.Text
  mood           String?
  checkinDateKey String
  user           user             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CheckIn_userId_fkey")
  dailymessage   dailymessage?
  friendactivity friendactivity[]

  @@unique([userId, checkDate], map: "CheckIn_userId_checkDate_key")
  @@unique([userId, checkinDateKey], map: "CheckIn_userId_checkinDateKey_key")
  @@index([checkDate], map: "CheckIn_checkDate_idx")
  @@index([userId, createdAt], map: "CheckIn_userId_createdAt_idx")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model checkin_backup_timezone_fix {
  id             String?
  checkDate      DateTime?
  points         Int?
  streakDay      Int?
  createdAt      DateTime?
  userId         String?
  isMakeUp       Boolean?
  exp            Int?
  message        String?
  mood           String?
  checkinDateKey String?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model checkin_before_duplicate_fix {
  id             String?
  checkDate      DateTime?
  points         Int?
  streakDay      Int?
  createdAt      DateTime?
  userId         String?
  isMakeUp       Boolean?
  exp            Int?
  message        String?
  mood           String?
  checkinDateKey String?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model checkin_before_streak_fix {
  id             String?
  checkDate      DateTime?
  points         Int?
  streakDay      Int?
  createdAt      DateTime?
  userId         String?
  isMakeUp       Boolean?
  exp            Int?
  message        String?
  mood           String?
  checkinDateKey String?

  @@ignore
}

model conversation {
  id                      String                    @id
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  lastMessageAt           DateTime?
  pairKey                 String?                   @unique(map: "Conversation_pairKey_key")
  conversationparticipant conversationparticipant[]
  directmessage           directmessage[]

  @@index([lastMessageAt], map: "Conversation_lastMessageAt_idx")
}

model conversationparticipant {
  id             String       @id
  lastReadAt     DateTime?
  isDeleted      Boolean      @default(false)
  isMuted        Boolean      @default(false)
  joinedAt       DateTime     @default(now())
  conversationId String
  userId         String
  conversation   conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "ConversationParticipant_conversationId_fkey")
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ConversationParticipant_userId_fkey")

  @@unique([conversationId, userId], map: "ConversationParticipant_conversationId_userId_key")
  @@index([userId, isDeleted], map: "ConversationParticipant_userId_isDeleted_idx")
}

model culturecomment {
  id          String      @id
  content     String
  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  itemId      String
  userId      String
  cultureitem cultureitem @relation(fields: [itemId], references: [id], onDelete: Cascade, map: "CultureComment_itemId_fkey")
  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CultureComment_userId_fkey")

  @@index([itemId, createdAt], map: "CultureComment_itemId_createdAt_idx")
  @@index([userId, createdAt], map: "CultureComment_userId_createdAt_idx")
}

model culturefavorite {
  id          String      @id
  createdAt   DateTime    @default(now())
  itemId      String
  userId      String
  cultureitem cultureitem @relation(fields: [itemId], references: [id], onDelete: Cascade, map: "CultureFavorite_itemId_fkey")
  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CultureFavorite_userId_fkey")

  @@unique([itemId, userId], map: "CultureFavorite_itemId_userId_key")
  @@index([userId, createdAt], map: "CultureFavorite_userId_createdAt_idx")
}

model cultureitem {
  id                  String                @id
  type                cultureitem_type
  title               String
  slug                String                @unique(map: "CultureItem_slug_key")
  subtitle            String?
  coverUrl            String?
  releaseDate         DateTime?
  lyricist            String?
  composer            String?
  arranger            String?
  albumName           String?
  roleName            String?
  city                String?
  summary             String?
  background          String?
  legalExcerpt        String?
  mvUrl               String?
  liveUrl             String?
  trailerUrl          String?
  rating              Float?
  favoriteCount       Int                   @default(0)
  commentCount        Int                   @default(0)
  isVisible           Boolean               @default(true)
  sortOrder           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  culturecomment      culturecomment[]
  culturefavorite     culturefavorite[]
  lyriccard           lyriccard[]
  useralbumcollection useralbumcollection[]

  @@index([releaseDate], map: "CultureItem_releaseDate_idx")
  @@index([type, isVisible, sortOrder], map: "CultureItem_type_isVisible_sortOrder_idx")
}

model dailyexperiencerecord {
  id        String   @id
  date      DateTime
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "DailyExperienceRecord_userId_fkey")

  @@unique([userId, date], map: "DailyExperienceRecord_userId_date_key")
  @@index([date], map: "DailyExperienceRecord_date_idx")
}

model dailymessage {
  id                   String                 @id
  date                 DateTime
  mood                 String?
  content              String
  likeCount            Int                    @default(0)
  commentCount         Int                    @default(0)
  favoriteCount        Int                    @default(0)
  shareCount           Int                    @default(0)
  isPinned             Boolean                @default(false)
  isFeatured           Boolean                @default(false)
  isDeleted            Boolean                @default(false)
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  userId               String
  checkInId            String?                @unique(map: "DailyMessage_checkInId_key")
  checkin              checkin?               @relation(fields: [checkInId], references: [id], map: "DailyMessage_checkInId_fkey")
  user                 user                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "DailyMessage_userId_fkey")
  dailymessagecomment  dailymessagecomment[]
  dailymessagefavorite dailymessagefavorite[]
  dailymessagelike     dailymessagelike[]
  friendactivity       friendactivity[]
  report               report[]

  @@index([date, createdAt], map: "DailyMessage_date_createdAt_idx")
  @@index([date, likeCount], map: "DailyMessage_date_likeCount_idx")
  @@index([date, isDeleted, isPinned, isFeatured, likeCount, commentCount, createdAt], map: "DailyMessage_hot_idx")
  @@index([isDeleted], map: "DailyMessage_isDeleted_idx")
  @@index([isPinned, isFeatured], map: "DailyMessage_isPinned_isFeatured_idx")
  @@index([date, isDeleted, isPinned, isFeatured, createdAt], map: "DailyMessage_latest_idx")
  @@index([userId, createdAt], map: "DailyMessage_userId_createdAt_idx")
}

model dailymessagecomment {
  id                        String                @id
  content                   String
  isDeleted                 Boolean               @default(false)
  deletedAt                 DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime
  messageId                 String
  authorId                  String
  parentId                  String?
  user                      user                  @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "DailyMessageComment_authorId_fkey")
  dailymessage              dailymessage          @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "DailyMessageComment_messageId_fkey")
  dailymessagecomment       dailymessagecomment?  @relation("dailymessagecommentTodailymessagecomment", fields: [parentId], references: [id], onDelete: NoAction, map: "DailyMessageComment_parentId_fkey")
  other_dailymessagecomment dailymessagecomment[] @relation("dailymessagecommentTodailymessagecomment")

  @@index([authorId, createdAt], map: "DailyMessageComment_authorId_createdAt_idx")
  @@index([messageId, createdAt], map: "DailyMessageComment_messageId_createdAt_idx")
  @@index([parentId], map: "DailyMessageComment_parentId_idx")
}

model dailymessagefavorite {
  id           String       @id
  createdAt    DateTime     @default(now())
  messageId    String
  userId       String
  dailymessage dailymessage @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "DailyMessageFavorite_messageId_fkey")
  user         user         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "DailyMessageFavorite_userId_fkey")

  @@unique([messageId, userId], map: "DailyMessageFavorite_messageId_userId_key")
  @@index([userId, createdAt], map: "DailyMessageFavorite_userId_createdAt_idx")
}

model dailymessagelike {
  id           String       @id
  createdAt    DateTime     @default(now())
  messageId    String
  userId       String
  dailymessage dailymessage @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "DailyMessageLike_messageId_fkey")
  user         user         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "DailyMessageLike_userId_fkey")

  @@unique([messageId, userId], map: "DailyMessageLike_messageId_userId_key")
  @@index([userId, createdAt], map: "DailyMessageLike_userId_createdAt_idx")
}

model dailyquote {
  id        String   @id
  content   String
  source    String?
  songTitle String?
  isPinned  Boolean  @default(false)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([isPinned, isVisible], map: "DailyQuote_isPinned_isVisible_idx")
  @@index([sortOrder], map: "DailyQuote_sortOrder_idx")
}

model dailytaskprogress {
  id                String            @id
  taskDate          DateTime
  progress          Int               @default(0)
  isCompleted       Boolean           @default(false)
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  userId            String
  templateId        String
  dailytasktemplate dailytasktemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, map: "DailyTaskProgress_templateId_fkey")
  user              user              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "DailyTaskProgress_userId_fkey")

  @@unique([userId, templateId, taskDate], map: "DailyTaskProgress_userId_templateId_taskDate_key")
  @@index([taskDate, isCompleted], map: "DailyTaskProgress_taskDate_isCompleted_idx")
  @@index([templateId], map: "DailyTaskProgress_templateId_fkey")
}

model dailytasktemplate {
  id                String              @id
  key               String              @unique(map: "DailyTaskTemplate_key_key")
  title             String
  description       String?
  target            Int                 @default(1)
  points            Int                 @default(0)
  exp               Int                 @default(0)
  sortOrder         Int                 @default(0)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  dailytaskprogress dailytaskprogress[]

  @@index([isActive, sortOrder], map: "DailyTaskTemplate_isActive_sortOrder_idx")
}

model directmessage {
  id             String             @id
  type           directmessage_type @default(TEXT)
  content        String
  imageUrl       String?
  isDeleted      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  conversationId String
  senderId       String
  conversation   conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "DirectMessage_conversationId_fkey")
  user           user               @relation(fields: [senderId], references: [id], onDelete: Cascade, map: "DirectMessage_senderId_fkey")

  @@index([conversationId, createdAt], map: "DirectMessage_conversationId_createdAt_idx")
  @@index([senderId, createdAt], map: "DirectMessage_senderId_createdAt_idx")
}

model emailverification {
  id        String    @id
  tokenHash String    @unique(map: "EmailVerification_tokenHash_key")
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "EmailVerification_userId_fkey")

  @@index([email], map: "EmailVerification_email_idx")
  @@index([expiresAt], map: "EmailVerification_expiresAt_idx")
  @@index([userId], map: "EmailVerification_userId_fkey")
}

model entertainmentdailydraw {
  id                  String             @id
  dateKey             String
  points              Int
  prescriptionCode    String             @unique(map: "EntertainmentDailyDraw_prescriptionCode_key")
  lyricText           String?
  songTitle           String?
  albumTitle          String?
  createdAt           DateTime           @default(now())
  userId              String
  lyricPrescriptionId String?
  lyricprescription   lyricprescription? @relation(fields: [lyricPrescriptionId], references: [id], onDelete: Restrict, map: "EntertainmentDailyDraw_lyricPrescriptionId_fkey")
  user                user               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "EntertainmentDailyDraw_userId_fkey")
  pointlog            pointlog?

  @@unique([userId, dateKey], map: "EntertainmentDailyDraw_userId_dateKey_key")
  @@index([dateKey], map: "EntertainmentDailyDraw_dateKey_idx")
  @@index([lyricPrescriptionId], map: "EntertainmentDailyDraw_lyricPrescriptionId_idx")
  @@index([userId, createdAt], map: "EntertainmentDailyDraw_userId_createdAt_idx")
  @@index([userId], map: "EntertainmentDailyDraw_userId_idx")
}

model experiencelog {
  id          String             @id
  amount      Int
  type        experiencelog_type
  description String
  createdAt   DateTime           @default(now())
  userId      String
  sourceType  String?
  sourceId    String?
  user        user               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ExperienceLog_userId_fkey")

  @@unique([sourceType, sourceId], map: "ExperienceLog_sourceType_sourceId_key")
