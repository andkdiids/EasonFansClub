generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  MUTED
  DELETED
  MERGED
  DISABLED
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
}

enum DeviceType {
  WEB
  MOBILE
  TABLET
  API
}

enum PostStatus {
  DRAFT
  PUBLISHED
  LOCKED
  DELETED
}

enum PostContentType {
  NORMAL
  IMAGE
  VIDEO
  POLL
  ARTICLE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PointActionType {
  REGISTER
  LOGIN
  POST_CREATE
  REPLY_CREATE
  DAILY_CHECK_IN
  CONTINUOUS_CHECK_IN_BONUS
  POST_LIKE_RECEIVED
  FEATURED_POST
  ACTIVITY_REWARD
  BADGE_EXCHANGE
  ADMIN_ADJUST
}

enum AdminActionType {
  DELETE_USER
  RESTORE_USER
  BAN_USER
  UNBAN_USER
  UPDATE_USER_ROLE
  UPDATE_USER_POINTS
  DELETE_POST
  RESTORE_POST
  PIN_POST
  UNPIN_POST
  FEATURE_POST
  UNFEATURE_POST
  RECOMMEND_POST
  UNRECOMMEND_POST
  LOCK_POST
  UNLOCK_POST
  DELETE_REPLY
  RESTORE_REPLY
  ADJUST_POINTS
  UPDATE_BOARD
  CREATE_BOARD
  DELETE_BOARD
  CREATE_BADGE
  GRANT_BADGE
  CREATE_ACTIVITY
  UPDATE_SETTING
}

enum AchievementRarity {
  NORMAL
  RARE
  EPIC
  LEGENDARY
  LIMITED
}

enum AchievementCategory {
  REGISTER
  CHECKIN_STREAK
  CHECKIN_TOTAL
  POST
  MUSIC
  FRIEND
  ACTIVE
  SPECIAL
}

enum CultureContentType {
  SONG
  ALBUM
  FILM
  LIVE
}

enum ReportTargetType {
  POST
  REPLY
  USER
  MESSAGE
  DAILY_MESSAGE
  DAILY_MESSAGE_COMMENT
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum NotificationType {
  REPLY
  LIKE
  FRIEND_REQUEST
  SYSTEM
  MESSAGE
  ACTIVITY
  ADMIN
  FOLLOW
  BADGE
}

enum SystemNotificationType {
  SYSTEM
  UPDATE
  ANNOUNCEMENT
  ACTIVITY
  MAINTENANCE
  SECURITY
}

enum MessageType {
  TEXT
  IMAGE
  EMOJI
  SYSTEM
}

enum ActivityType {
  CONCERT_SIGNUP
  GATHERING
  ONLINE
  LOTTERY
  OTHER
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  FINISHED
  CANCELLED
}

enum RewardType {
  BADGE
  PHYSICAL
  COUPON
  POINTS
}

enum SiteSettingValueType {
  TEXT
  IMAGE
  JSON
  BOOLEAN
  NUMBER
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PasswordResetType {
  SECURITY_QUESTION
  EMAIL
}

enum PasswordResetStage {
  CHALLENGE
  RESET_CODE
  RESET_TOKEN
}

enum ProfileWallVisibility {
  PUBLIC
  FRIENDS
  CLOSED
}

enum FeedbackStatus {
  OPEN
  PROCESSING
  REPLIED
  RESOLVED
  CLOSED
}

enum FeedbackType {
  BUG
  EXPERIENCE
  SUGGESTION
  CONTENT
  ACCOUNT
  OTHER
}

enum ChangelogType {
  FEATURE
  IMPROVEMENT
  FIX
  SECURITY
  CONTENT
}

enum ChangelogStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum PageLayoutRevisionSource {
  MANUAL
  ROLLBACK
  DEFAULT
}

enum ExperienceLogType {
  CHECKIN
  TASK
  POST
  COMMENT
  LIKE
  ACTIVITY
  ADMIN
  OTHER
}

model User {
  id                              String             @id @default(cuid())
  uid                             Int                @unique @default(autoincrement())
  username                        String
  email                           String?
  phone                           String?
  passwordHash                    String
  nickname                        String
  avatarUrl                       String?
  backgroundUrl                   String?
  bio                             String?
  role                            UserRole           @default(USER)
  status                          UserStatus         @default(ACTIVE)
  verificationStatus              VerificationStatus @default(NONE)
  level                           Int                @default(1)
  exp                             Int                @default(0)
  experience                      Int                @default(0)
  points                          Int                @default(0)
  consecutiveDays                 Int                @default(0)
  lastCheckInDate                 DateTime?
  emailVerifiedAt                 DateTime?
  phoneVerifiedAt                 DateTime?
  lastLoginAt                     DateTime?
  lastActiveAt                    DateTime?
  nicknameChangedAt               DateTime?
  isOnline                        Boolean            @default(false)
  isDeleted                       Boolean            @default(false)
  deletedAt                       DateTime?
  securityQuestionRecoveryEnabled Boolean            @default(false)
  registrationIdempotencyKeyHash  String?            @unique
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  profile                     Profile?
  posts                       Post[]
  replies                     Reply[]
  likes                       Like[]
  replyLikes                  ReplyLike[]
  favorites                   PostFavorite[]
  boardFavorites              BoardFavorite[]
  activityFavorites           ActivityFavorite[]
  checkIns                    CheckIn[]
  dailyMessages               DailyMessage[]
  dailyMessageLikes           DailyMessageLike[]
  dailyMessageFavorites       DailyMessageFavorite[]
  dailyMessageComments        DailyMessageComment[]
  dailyTaskProgress           DailyTaskProgress[]
  pointLogs                   PointLog[]
  badges                      UserBadge[]
  devices                     LoginDevice[]
  onlineSessions              OnlineSession[]
  emailVerifications          EmailVerification[]
  passwordResets              PasswordResetToken[]
  securityQuestions           UserSecurityQuestion[]
  securityLogs                AccountSecurityLog[]
  sentNotifications           Notification[]            @relation("NotificationActor")
  notifications               Notification[]            @relation("NotificationRecipient")
  createdSystemNotifications  SystemNotification[]      @relation("SystemNotificationCreator")
  systemNotificationReads     SystemNotificationRead[]
  following                   Follow[]                  @relation("FollowFollower")
  followers                   Follow[]                  @relation("FollowFollowing")
  sentFriendRequests          FriendRequest[]           @relation("FriendRequestSender")
  receivedFriendRequests      FriendRequest[]           @relation("FriendRequestReceiver")
  friendshipsA                Friendship[]              @relation("FriendshipUserA")
  friendshipsB                Friendship[]              @relation("FriendshipUserB")
  blocksMade                  Block[]                   @relation("Blocker")
  blockedBy                   Block[]                   @relation("Blocked")
  conversations               ConversationParticipant[]
  messages                    DirectMessage[]
  reports                     Report[]                  @relation("Reporter")
  reportedReports             Report[]                  @relation("ReportedUser")
  activityRegistrations       ActivityRegistration[]
  lotteryEntries              LotteryEntry[]
  searchHistory               SearchHistory[]
  feedbacks                   Feedback[]
  feedbackReplies             FeedbackReply[]
  createdChangelogs           Changelog[]               @relation("ChangelogCreator")
  musicFavorites              MusicFavorite[]
  musicPlayRecords            MusicPlayRecord[]
  achievements                UserAchievement[]
  albumCollections            UserAlbumCollection[]
  cultureFavorites            CultureFavorite[]
  cultureComments             CultureComment[]
  lyricCards                  LyricCard[]
  adminActions                AdminAction[]             @relation("AdminOperator")
  targetAdminActions          AdminAction[]             @relation("AdminTargetUser")
  adminPermissions            AdminPermission[]
  updatedPageLayouts          PageLayout[]              @relation("PageLayoutUpdatedBy")
  publishedPageLayouts        PageLayout[]              @relation("PageLayoutPublishedBy")
  pageLayoutRevisions         PageLayoutRevision[]      @relation("PageLayoutRevisionPublisher")
  profileWallMessagesSent     ProfileWallMessage[]      @relation("ProfileWallSender")
  profileWallMessagesReceived ProfileWallMessage[]      @relation("ProfileWallReceiver")
  friendActivities            FriendActivity[]          @relation("FriendActivityActor")
  experienceLogs              ExperienceLog[]
  dailyExperienceRecords      DailyExperienceRecord[]

  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@index([uid])
  @@index([username])
  @@index([phone])
  @@index([email])
  @@index([points])
  @@index([level])
  @@index([experience])
  @@index([lastActiveAt])
  @@index([createdAt])
}

model Profile {
  id             String                @id @default(cuid())
  displayName    String
  avatarUrl      String?
  backgroundUrl  String?
  bio            String?
  wallVisibility ProfileWallVisibility @default(PUBLIC)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@index([wallVisibility])
}

model ProfileWallMessage {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  senderId String
  sender   User   @relation("ProfileWallSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User   @relation("ProfileWallReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ProfileWallMessage?  @relation("ProfileWallThread", fields: [parentId], references: [id], onDelete: NoAction)
  children ProfileWallMessage[] @relation("ProfileWallThread")

  @@index([receiverId, createdAt])
  @@index([senderId, createdAt])
  @@index([parentId])
  @@index([deletedAt])
}

model BoardCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boards Board[]

  @@index([sortOrder])
}

model Board {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  coverUrl      String?
  sortOrder     Int      @default(0)
  postCount     Int      @default(0)
  followerCount Int      @default(0)
  isActive      Boolean  @default(true)
  isHot         Boolean  @default(false)
  isRecommended Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId String?
  category   BoardCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Board?  @relation("BoardTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Board[] @relation("BoardTree")

  posts        Post[]
  favorites    BoardFavorite[]
  adminActions AdminAction[]

  @@index([categoryId])
  @@index([parentId])
  @@index([sortOrder])
  @@index([isActive])
  @@index([isHot])
  @@index([isRecommended])
}

model Post {
  id            String          @id @default(cuid())
  title         String
  content       String
  summary       String?
  status        PostStatus      @default(PUBLISHED)
  contentType   PostContentType @default(NORMAL)
  viewCount     Int             @default(0)
  readUserCount Int             @default(0)
  likeCount     Int             @default(0)
  replyCount    Int             @default(0)
  favoriteCount Int             @default(0)
  shareCount    Int             @default(0)
  isPinned      Boolean         @default(false)
  isFeatured    Boolean         @default(false)
  isRecommended Boolean         @default(false)
  isLocked      Boolean         @default(false)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  publishedAt   DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Restrict)

  replies      Reply[]
  likes        Like[]
  favorites    PostFavorite[]
  media        PostMedia[]
  tags         PostTag[]
  poll         Poll?
  reports      Report[]
  adminActions AdminAction[]

  @@index([boardId, createdAt])
  @@index([boardId, status, isDeleted, isPinned, isFeatured, createdAt])
  @@index([authorId, createdAt])
  @@index([status])
  @@index([status, isDeleted, isPinned, isFeatured, createdAt])
  @@index([status, isDeleted, isPinned, isFeatured, likeCount, replyCount])
  @@index([contentType])
  @@index([isPinned, createdAt])
  @@index([isFeatured, createdAt])
  @@index([isRecommended, createdAt])
  @@index([isDeleted])
  @@index([likeCount])
  @@index([replyCount])
}

model Reply {
  id        String    @id @default(cuid())
  content   String
  likeCount Int       @default(0)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Reply?  @relation("ReplyThread", fields: [parentId], references: [id], onDelete: NoAction)
  children Reply[] @relation("ReplyThread")

  likes        ReplyLike[]
  reports      Report[]
  adminActions AdminAction[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
  @@index([isDeleted])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
}

model ReplyLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  replyId String
  reply   Reply  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([userId, createdAt])
  @@index([replyId, createdAt])
}

model PostFavorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model BoardFavorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId, createdAt])
}

model Tag {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  posts PostTag[]

  @@index([usageCount])
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model PostMedia {
  id        String    @id @default(cuid())
  type      MediaType
  url       String
  thumbnail String?
  width     Int?
  height    Int?
  size      Int?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model Poll {
  id         String    @id @default(cuid())
  question   String
  allowMulti Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  postId  String       @unique
  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id        String @id @default(cuid())
  title     String
  voteCount Int    @default(0)
  sortOrder Int    @default(0)

  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId, sortOrder])
}

model PollVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

model CheckIn {
  id             String   @id @default(cuid())
  checkDate      DateTime
  checkinDateKey String
  points         Int      @default(10)
  exp            Int      @default(0)
  streakDay      Int      @default(1)
  isMakeUp       Boolean  @default(false)
  mood           String?
  message        String?
  createdAt      DateTime @default(now())

  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyMessage     DailyMessage?
  friendActivities FriendActivity[]

  @@unique([userId, checkDate])
  @@unique([userId, checkinDateKey])
  @@index([checkDate])
  @@index([userId, createdAt])
}

model DailyMessage {
  id            String    @id @default(cuid())
  date          DateTime
  mood          String
  content       String
  likeCount     Int       @default(0)
  commentCount  Int       @default(0)
  favoriteCount Int       @default(0)
  shareCount    Int       @default(0)
  isPinned      Boolean   @default(false)
  isFeatured    Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  checkInId String?  @unique
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  likes            DailyMessageLike[]
  favorites        DailyMessageFavorite[]
  comments         DailyMessageComment[]
  reports          Report[]
  friendActivities FriendActivity[]

  @@index([date, createdAt])
  @@index([date, likeCount])
  @@index([date, isDeleted, isPinned, isFeatured, createdAt])
  @@index([date, isDeleted, isPinned, isFeatured, likeCount, commentCount, createdAt])
  @@index([userId, createdAt])
  @@index([isPinned, isFeatured])
  @@index([isDeleted])
}

model FriendActivity {
  id        String   @id @default(cuid())
  mood      String?
  content   String?
  createdAt DateTime @default(now())

  actorId String
  actor   User   @relation("FriendActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  checkInId String?
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  dailyMessageId String?
  dailyMessage   DailyMessage? @relation(fields: [dailyMessageId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([checkInId])
  @@index([dailyMessageId])
}

model GrowthLevelConfig {
  id          String   @id @default(cuid())
  level       Int      @unique
  name        String
  requiredExp Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requiredExp])
}

model ExperienceLog {
  id          String            @id @default(cuid())
  amount      Int
  type        ExperienceLogType
  description String
  createdAt   DateTime          @default(now())
  sourceType  String?
  sourceId    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model DailyExperienceRecord {
  id        String   @id @default(cuid())
  date      DateTime
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model Task {
  id          String   @id @default(cuid())
  name        String
  description String?
  expReward   Int
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([createdAt])
}

model DailyMessageLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  messageId String
  message   DailyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model DailyMessageFavorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  messageId String
  message   DailyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model DailyMessageComment {
  id        String    @id @default(cuid())
  content   String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messageId String
  message   DailyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   DailyMessageComment?  @relation("DailyMessageCommentThread", fields: [parentId], references: [id], onDelete: NoAction)
  children DailyMessageComment[] @relation("DailyMessageCommentThread")

  @@index([messageId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model DailyTaskTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  target      Int      @default(1)
  points      Int      @default(0)
  exp         Int      @default(0)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress DailyTaskProgress[]

  @@index([isActive, sortOrder])
}

model DailyTaskProgress {
  id          String    @id @default(cuid())
  taskDate    DateTime
  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String
  template   DailyTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId, taskDate])
  @@index([taskDate, isCompleted])
}

model PointLog {
  id        String          @id @default(cuid())
  action    PointActionType
  points    Int
  before    Int
  after     Int
  reason    String?
  createdAt DateTime        @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId     String?
  replyId    String?
  checkInId  String?
  activityId String?
  badgeId    String?

  @@unique([action, checkInId])
  @@index([userId, createdAt])
  @@index([action])
  @@index([postId])
  @@index([replyId])
  @@index([checkInId])
  @@index([activityId])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  pointsCost  Int?
  isAutoGrant Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserBadge[]

  @@index([isActive])
}

model UserBadge {
  id           String   @id @default(cuid())
  isHidden     Boolean  @default(false)
  displayOrder Int      @default(0)
  grantedAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId, displayOrder])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  content     String?
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  readAt      DateTime?
  key         String?
