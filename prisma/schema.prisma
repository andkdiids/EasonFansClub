/// 昵称违规记录，供后台审核与处罚冷却追溯。
/// userId 为普通标量（非 Prisma 关系），避免改动 User 关系列表。
model NicknameViolationLog {
  id                   String    @id @default(cuid())
  userId               String
  originalNickname     String?   @db.VarChar(32)
  reason               String?
  violationGeneratedAt DateTime  @default(now())
  generatedDisplayName String    @db.VarChar(32)
  resolvedAt           DateTime?
  resolvedNickname     String?   @db.VarChar(32)
  violationCount       Int       @default(1)
  createdAt            DateTime  @default(now())

  @@index([userId])
}
