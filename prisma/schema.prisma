generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AccountSecurityLog {
  id        String   @id @default(cuid())
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

model Achievement {
  id              String              @id @default(cuid())
  title           String
  slug            String              @unique
  description     String?
  icon            String?
  imageUrl        String?
  color           String?
  category        AchievementCategory
  rarity          AchievementRarity   @default(NORMAL)
  conditionKey    String?
  conditionValue  Int?
  isAutoGrant     Boolean             @default(true)
  isVisible       Boolean             @default(true)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  UserAchievement UserAchievement[]

  @@index([category, sortOrder])
  @@index([isVisible])
  @@index([rarity])
}

model Activity {
  id                   String                 @id @default(cuid())
  title                String
  description          String
  type                 ActivityType           @default(OTHER)
  status               ActivityStatus         @default(DRAFT)
  coverUrl             String?
  pointsReward         Int?
  signupLimit          Int?
  signupCount          Int                    @default(0)
  startsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  ActivityFavorite     ActivityFavorite[]
  ActivityRegistration ActivityRegistration[]
  Lottery              Lottery[]

  @@index([status, createdAt])
  @@index([status, startsAt])
  @@index([type])
}

model ActivityFavorite {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  activityId String
  userId     String
  Activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
}

model ActivityRegistration {
  id          String    @id @default(cuid())
  note        String?
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())
  activityId  String
  userId      String
  Activity    Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId, createdAt])
}

model AdminAction {
  id                                  String          @id @default(cuid())
  action                              AdminActionType
  reason                              String?
  metadata                            Json?
  createdAt                           DateTime        @default(now())
  adminId                             String?
  operatorName                        String?
  operatorUsername                    String?
  operatorUid                         Int?
  operationType                       String?
  targetType                          String?
  targetId                            String?
  targetTitle                         String?
  targetUserId                        String?
  targetUserName                      String?
  targetUserUid                       Int?
  result                              String?         @default("SUCCESS")
  postId                              String?
  replyId                             String?
  boardId                             String?
  User_AdminAction_adminIdToUser      User?           @relation("AdminAction_adminIdToUser", fields: [adminId], references: [id], onDelete: SetNull)
  Board                               Board?          @relation(fields: [boardId], references: [id])
  Post                                Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  Reply                               Reply?          @relation(fields: [replyId], references: [id])
  User_AdminAction_targetUserIdToUser User?           @relation("AdminAction_targetUserIdToUser", fields: [targetUserId], references: [id])

  @@index([action])
  @@index([operationType, createdAt])
  @@index([adminId, createdAt])
  @@index([operatorUid, createdAt])
  @@index([targetType, createdAt])
  @@index([targetId, createdAt])
  @@index([boardId])
  @@index([postId])
  @@index([replyId])
  @@index([targetUserId])
}

model AdminActionLog {
  id                                     String   @id @default(cuid())
  adminId                                String
  action                                 String
  targetUserId                           String
  detail                                 Json?
  createdAt                              DateTime @default(now())
  User_AdminActionLog_adminIdToUser      User     @relation("AdminActionLog_adminIdToUser", fields: [adminId], references: [id], onDelete: Cascade)
  User_AdminActionLog_targetUserIdToUser User     @relation("AdminActionLog_targetUserIdToUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([action, createdAt])
  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
}

model AdminPermission {
  id            String   @id @default(cuid())
  permissionKey String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([permissionKey, enabled])
  @@index([userId, enabled])
}

model UserReward {
  id                    String   @id @default(cuid())
  transactionId         String   @unique
  userId                String
  operatorId            String
  usernameSnapshot      String
  experienceAmount      Int      @default(0)
  registrationFeeAmount Int      @default(0)
  reason                String   @db.VarChar(500)
  createdAt             DateTime @default(now())
  recipient             User     @relation("UserRewardRecipient", fields: [userId], references: [id], onDelete: Cascade)
  operator              User     @relation("UserRewardOperator", fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([operatorId, createdAt])
  @@index([createdAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  isPinned    Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, isPinned])
}

enum BadgeCategory {
  SYSTEM
  BIRTHDAY
  CONCERT
}

model Badge {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  iconUrl     String?
  pointsCost  Int?
  category    BadgeCategory @default(SYSTEM)
  musicTourId String?
  musicTour   MusicTour?    @relation(fields: [musicTourId], references: [id], onDelete: SetNull)
  isAutoGrant Boolean       @default(false)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  UserBadge   UserBadge[]

  @@index([isActive])
  @@index([category])
  @@index([musicTourId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  link      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model BirthdayMessage {
  id        String   @id @default(cuid())
  title     String   @default("🎂 生日纪念")
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model TodayEvent {
  id                 String                  @id @default(cuid())
  date               DateTime                @db.Date
  month              Int
  day                Int
  type               TodayEventType
  title              String
  content            String                  @db.Text
  moderationStatus   ContentModerationStatus @default(NORMAL)
  moderationReason   String?
  matchedBannedWords String?                 @db.Text
  imageUrl           String?
  source             TodayEventSource        @default(ADMIN)
  reference          String?
  status             TodayEventStatus        @default(PENDING)
  rejectionReason    String?                 @db.Text
  reviewedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  submittedById      String?
  reviewedById       String?
  SubmittedBy        User?                   @relation("TodayEventSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  ReviewedBy         User?                   @relation("TodayEventReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([month, day, status])
  @@index([status, createdAt])
  @@index([submittedById, createdAt])
}

model UserDailyMusicRecommendation {
  id            String    @id @default(cuid())
  recommendDate String
  anonymousId   String?
  createdAt     DateTime  @default(now())
  userId        String?
  songId        String
  User          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  MusicSong     MusicSong @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendDate])
  @@unique([anonymousId, recommendDate])
  @@index([recommendDate])
  @@index([songId, recommendDate])
}

model Block {
  id                         String   @id @default(cuid())
  reason                     String?
  createdAt                  DateTime @default(now())
  blockerId                  String
  blockedId                  String
  User_Block_blockedIdToUser User     @relation("Block_blockedIdToUser", fields: [blockedId], references: [id], onDelete: Cascade)
  User_Block_blockerIdToUser User     @relation("Block_blockerIdToUser", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Board {
  id            String          @id @default(cuid())
  name          String          @unique
  slug          String          @unique
  description   String?
  sortOrder     Int             @default(0)
  postCount     Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  categoryId    String?
  coverUrl      String?
  followerCount Int             @default(0)
  isHot         Boolean         @default(false)
  isRecommended Boolean         @default(false)
  parentId      String?
  AdminAction   AdminAction[]
  BoardCategory BoardCategory?  @relation(fields: [categoryId], references: [id])
  Board         Board?          @relation("BoardToBoard", fields: [parentId], references: [id])
  other_Board   Board[]         @relation("BoardToBoard")
  BoardFavorite BoardFavorite[]
  Post          Post[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isHot])
  @@index([isRecommended])
  @@index([parentId])
  @@index([sortOrder])
}

model BoardCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Board       Board[]

  @@index([sortOrder])
}

model BoardFavorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  boardId   String
  userId    String
  Board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId, createdAt])
}

model Changelog {
  id          String          @id @default(cuid())
  version     String          @unique
  major       Int
  minor       Int
  patch       Int
  title       String
  content     String
  type        ChangelogType
  isMajor     Boolean         @default(false)
  status      ChangelogStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String
  User        User            @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, createdAt])
  @@index([major, minor, patch])
  @@index([status, publishedAt])
}

model CheckIn {
  id             String           @id @default(cuid())
  checkDate      DateTime
  points         Int              @default(10)
  streakDay      Int              @default(1)
  createdAt      DateTime         @default(now())
  userId         String
  isMakeUp       Boolean          @default(false)
  exp            Int              @default(0)
  message        String?
  mood           String?
  moodType       String?          @db.VarChar(16)
  moodEmoji      String?          @db.VarChar(32)
  moodText       String?          @db.VarChar(191)
  checkinDateKey String
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  DailyMessage   DailyMessage?
  FriendActivity FriendActivity[]

  @@unique([userId, checkDate])
  @@unique([userId, checkinDateKey])
  @@index([checkDate])
  @@index([userId, createdAt])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model CheckIn_backup_timezone_fix {
  id             String?
  checkDate      DateTime?
  points         Int?
  streakDay      Int?
  createdAt      DateTime?
  userId         String?
  isMakeUp       Boolean?
  exp            Int?
  message        String?
  mood           String?
  checkinDateKey String?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model CheckIn_before_duplicate_fix {
  id             String?
  checkDate      DateTime?
  points         Int?
  streakDay      Int?
  createdAt      DateTime?
  userId         String?
  isMakeUp       Boolean?
  exp            Int?
  message        String?
  mood           String?
  checkinDateKey String?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model CheckIn_before_streak_fix {
  id             String?
  checkDate      DateTime?
  points         Int?
  streakDay      Int?
  createdAt      DateTime?
  userId         String?
  isMakeUp       Boolean?
  exp            Int?
  message        String?
  mood           String?
  checkinDateKey String?

  @@ignore
}

model Conversation {
  id                      String                    @id @default(cuid())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  lastMessageAt           DateTime?
  pairKey                 String?                   @unique
  ConversationParticipant ConversationParticipant[]
  DirectMessage           DirectMessage[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  lastReadAt     DateTime?
  clearedAt      DateTime?
  isDeleted      Boolean      @default(false)
  isMuted        Boolean      @default(false)
  joinedAt       DateTime     @default(now())
  conversationId String
  userId         String
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isDeleted])
}

model CultureComment {
  id                 String                  @id @default(cuid())
  content            String
  ipRegion           String?
  isDeleted          Boolean                 @default(false)
  moderationStatus   ContentModerationStatus @default(NORMAL)
  moderationReason   String?
  matchedBannedWords String?                 @db.Text
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  itemId             String
  userId             String
  CultureItem        CultureItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  User               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([userId, createdAt])
}

model CultureFavorite {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  itemId      String
  userId      String
  CultureItem CultureItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  User        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId, createdAt])
}

model CultureItem {
  id                  String                @id @default(cuid())
  type                CultureContentType
  title               String
  slug                String                @unique
  subtitle            String?
  coverUrl            String?
  releaseDate         DateTime?
  lyricist            String?
  composer            String?
  arranger            String?
  albumName           String?
  roleName            String?
  city                String?
  summary             String?
  background          String?
  legalExcerpt        String?
  mvUrl               String?
  liveUrl             String?
  trailerUrl          String?
  rating              Float?
  favoriteCount       Int                   @default(0)
  commentCount        Int                   @default(0)
  isVisible           Boolean               @default(true)
  sortOrder           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  CultureComment      CultureComment[]
  CultureFavorite     CultureFavorite[]
  LyricCard           LyricCard[]
  UserAlbumCollection UserAlbumCollection[]

  @@index([releaseDate])
  @@index([type, isVisible, sortOrder])
}

model DailyExperienceRecord {
  id        String   @id @default(cuid())
  date      DateTime
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model DailyMessage {
  id                   String                 @id @default(cuid())
  date                 DateTime
  mood                 String?
  moodType             String?                @db.VarChar(16)
  moodEmoji            String?                @db.VarChar(32)
  moodText             String?                @db.VarChar(191)
  content              String
  ipRegion             String?
  likeCount            Int                    @default(0)
  commentCount         Int                    @default(0)
  favoriteCount        Int                    @default(0)
  shareCount           Int                    @default(0)
  isPinned             Boolean                @default(false)
  isFeatured           Boolean                @default(false)
  isDeleted            Boolean                @default(false)
  deletedAt            DateTime?
  moderationStatus     PostModerationStatus   @default(APPROVED)
  moderationReason     String?
  matchedBannedWords   String?                @db.Text
  sort                 Int                    @default(0)
  isAdminMessage       Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  userId               String
  checkInId            String?                @unique
  CheckIn              CheckIn?               @relation(fields: [checkInId], references: [id])
  User                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  DailyMessageComment  DailyMessageComment[]
  DailyMessageFavorite DailyMessageFavorite[]
  DailyMessageLike     DailyMessageLike[]
  FriendActivity       FriendActivity[]
  Report               Report[]

  @@index([date, createdAt])
  @@index([date, likeCount])
  @@index([date, isDeleted, isPinned, isFeatured, likeCount, commentCount, createdAt], map: "DailyMessage_hot_idx")
  @@index([isDeleted])
  @@index([isPinned, isFeatured])
  @@index([date, isDeleted, isPinned, isFeatured, createdAt], map: "DailyMessage_latest_idx")
  @@index([userId, createdAt])
  @@index([date, isAdminMessage, sort, createdAt])
}

model DailyMessageComment {
  id                        String                  @id @default(cuid())
  content                   String
  ipRegion                  String?
  isDeleted                 Boolean                 @default(false)
  moderationStatus          ContentModerationStatus @default(NORMAL)
  moderationReason          String?
  matchedBannedWords        String?                 @db.Text
  deletedAt                 DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  messageId                 String
  authorId                  String
  parentId                  String?
  User                      User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  DailyMessage              DailyMessage            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  DailyMessageComment       DailyMessageComment?    @relation("DailyMessageCommentToDailyMessageComment", fields: [parentId], references: [id], onDelete: NoAction)
  other_DailyMessageComment DailyMessageComment[]   @relation("DailyMessageCommentToDailyMessageComment")

  @@index([authorId, createdAt])
  @@index([messageId, createdAt])
  @@index([parentId])
}

model DailyMessageFavorite {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  messageId    String
  userId       String
  DailyMessage DailyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model DailyMessageLike {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  messageId    String
  userId       String
  DailyMessage DailyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model DailyQuote {
  id        String   @id @default(cuid())
  content   String
  source    String?
  songTitle String?
  isPinned  Boolean  @default(false)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPinned, isVisible])
  @@index([sortOrder])
}

model DailyTaskProgress {
  id                String            @id @default(cuid())
  taskDate          DateTime
  progress          Int               @default(0)
  isCompleted       Boolean           @default(false)
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userId            String
  templateId        String
  DailyTaskTemplate DailyTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  User              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId, taskDate])
  @@index([taskDate, isCompleted])
}

model DailyTaskTemplate {
  id                String              @id @default(cuid())
  key               String              @unique
  title             String
  description       String?
  target            Int                 @default(1)
  points            Int                 @default(0)
  exp               Int                 @default(0)
  sortOrder         Int                 @default(0)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  DailyTaskProgress DailyTaskProgress[]

  @@index([isActive, sortOrder])
}

model DirectMessage {
  id                 String                  @id @default(cuid())
  type               MessageType             @default(TEXT)
  content            String
  imageUrl           String?
  stickerId          String?
  sticker            Sticker?                @relation("DirectMessageSticker", fields: [stickerId], references: [id], onDelete: SetNull)
  isDeleted          Boolean                 @default(false)
  moderationStatus   ContentModerationStatus @default(NORMAL)
  moderationReason   String?
  matchedBannedWords String?                 @db.Text
  createdAt          DateTime                @default(now())
  conversationId     String
  senderId           String
  clientMessageId    String?
  Conversation       Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User               User                    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([stickerId])
}

model EmailVerification {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

model EHospitalCheckConfig {
  id            String   @id @default(cuid())
  enabled       Boolean  @default(true)
  questionCount Int      @default(10)
  audioSeconds  Int      @default(7)
  passScore     Int      @default(60)
  dailyLimit    Int      @default(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EHospitalCheckSession {
  id                    String                 @id @default(cuid())
  questions             Json
  answers               Json?
  score                 Int?
  status                String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  expiresAt             DateTime
  registrationDraftId   String
  RegistrationDraft     RegistrationDraft      @relation(fields: [registrationDraftId], references: [id], onDelete: Cascade)
  EHospitalCheckAttempt EHospitalCheckAttempt?

  @@index([registrationDraftId, status, createdAt])
  @@index([status, expiresAt])
}

model EHospitalCheckAttempt {
  id                    String                @id @default(cuid())
  sessionId             String                @unique
  score                 Int
  passed                Boolean
  ip                    String?
  identityHash          String?
  userId                String?
  registrationDraftId   String
  createdAt             DateTime              @default(now())
  EHospitalCheckSession EHospitalCheckSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  RegistrationDraft     RegistrationDraft     @relation(fields: [registrationDraftId], references: [id], onDelete: Cascade)
  User                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identityHash, createdAt])
  @@index([registrationDraftId, createdAt])
  @@index([userId, createdAt])
}

model RegistrationDraft {
  id                    String                  @id @default(cuid())
  tokenHash             String                  @unique
  registrationType      String
  username              String
  usernameNormalized    String
  nickname              String
  email                 String
  phone                 String
  passwordHash          String
  securityQuestions     Json?
  acceptedAgreement     Boolean                 @default(false)
  identityHash          String
  phoneCodeHash         String?
  phoneCodeExpiresAt    DateTime?
  phoneVerifiedAt       DateTime?
