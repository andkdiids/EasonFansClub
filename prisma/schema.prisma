}

// 演唱会分类（后台可配置）。三大核心分类 slug 固定为 main / small / guest，
// 与 MusicTour.category 枚举（MAIN / SMALL / GUEST）一一对应；其余为管理员扩展分类。
// 旧数据无需迁移：MusicTour 仍使用 category 枚举，天然落在三大核心分类中。
model MusicConcertCategory {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  sortOrder  Int         @default(0)
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  musicTours MusicTour[]

  @@index([sortOrder])
}

model MusicTrack {
  id              String            @id @default(cuid())
  title           String
  artist          String            @default("Eason Chan")
  source          String?
  sourceUrl       String?
  isPlayable      Boolean           @default(false)
  sortOrder       Int               @default(0)
  isVisible       Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  MusicFavorite   MusicFavorite[]
  MusicPlayRecord MusicPlayRecord[]

  @@unique([title, artist])
  @@index([isVisible, sortOrder])
  @@index([isVisible, sortOrder, createdAt], map: "MusicTrack_visible_sort_createdAt_idx")
}

model Notification {
  id                                  String           @id @default(cuid())
  type                                NotificationType
  title                               String
  content                             String?
  link                                String?
  isRead                              Boolean          @default(false)
  createdAt                           DateTime         @default(now())
  readAt                              DateTime?
  recipientId                         String
  actorId                             String?
  key                                 String?
  completedAt                         DateTime?
  User_Notification_actorIdToUser     User?            @relation("Notification_actorIdToUser", fields: [actorId], references: [id])
  User_Notification_recipientIdToUser User             @relation("Notification_recipientIdToUser", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, key])
  @@index([recipientId, isRead, createdAt])
  @@index([type])
}

model OnlineSession {
  id        String   @id @default(cuid())
  tokenId   String?
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PageLayout {
  id                                  String               @id @default(cuid())
  pageKey                             String               @unique
  draftConfig                         Json
  publishedConfig                     Json
  previousPublishedConfig             Json?
  version                             Int                  @default(1)
  publishedAt                         DateTime?
  createdAt                           DateTime             @default(now())
  updatedAt                           DateTime             @updatedAt
  updatedById                         String?
  publishedById                       String?
  User_PageLayout_publishedByIdToUser User?                @relation("PageLayout_publishedByIdToUser", fields: [publishedById], references: [id])
  User_PageLayout_updatedByIdToUser   User?                @relation("PageLayout_updatedByIdToUser", fields: [updatedById], references: [id])
  PageLayoutRevision                  PageLayoutRevision[]

  @@index([pageKey])
  @@index([publishedById])
  @@index([updatedById])
}

model PageLayoutRevision {
  id            String                   @id @default(cuid())
  pageLayoutId  String
  version       Int
  config        Json
  note          String?
  source        PageLayoutRevisionSource @default(MANUAL)
  createdAt     DateTime                 @default(now())
  publishedById String?
  PageLayout    PageLayout               @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)
  User          User?                    @relation(fields: [publishedById], references: [id])

  @@unique([pageLayoutId, version])
  @@index([pageLayoutId, createdAt])
  @@index([publishedById])
  @@index([source])
}

model PasswordResetToken {
  id           String             @id @default(cuid())
  tokenHash    String             @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime           @default(now())
  userId       String
  type         PasswordResetType  @default(EMAIL)
  stage        PasswordResetStage @default(RESET_TOKEN)
  codeHash     String?
  attemptCount Int                @default(0)
  User         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([codeHash])
  @@index([expiresAt])
  @@index([userId, type, stage, createdAt])
  @@index([type, stage, expiresAt])
}

model PointLog {
  id                     String                  @id @default(cuid())
  action                 PointActionType
  points                 Int
  before                 Int
  after                  Int
  reason                 String?
  createdAt              DateTime                @default(now())
  userId                 String
  postId                 String?
  replyId                String?
  checkInId              String?
  activityId             String?
  badgeId                String?
  dailyDrawId            String?                 @unique
  dateKey                String?
  businessKey            String?                 @unique
  EntertainmentDailyDraw EntertainmentDailyDraw? @relation(fields: [dailyDrawId], references: [id])
  User                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([action, checkInId])
  @@index([action])
  @@index([activityId])
  @@index([checkInId])
  @@index([postId])
  @@index([replyId])
  @@index([userId, createdAt])
}

model Poll {
  id         String       @id @default(cuid())
  question   String
  allowMulti Boolean      @default(false)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  postId     String       @unique
  Post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  PollOption PollOption[]
  PollVote   PollVote[]
}

model PollOption {
  id        String     @id @default(cuid())
  title     String
  voteCount Int        @default(0)
  sortOrder Int        @default(0)
  pollId    String
  Poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  PollVote  PollVote[]

  @@index([pollId, sortOrder])
}

model PollVote {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())
  pollId     String
  optionId   String
  userId     String
  PollOption PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  Poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

model Post {
  id                    String                  @id @default(cuid())
  title                 String
  content               String
  ipRegion              String?
  viewCount             Int                     @default(0)
  likeCount             Int                     @default(0)
  replyCount            Int                     @default(0)
  isPinned              Boolean                 @default(false)
  profilePinnedAt       DateTime?
  isFeatured            Boolean                 @default(false)
  isDeleted             Boolean                 @default(false)
  deletedAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  authorId              String
  boardId               String
  contentType           PostContentType         @default(NORMAL)
  favoriteCount         Int                     @default(0)
  isLocked              Boolean                 @default(false)
  isRecommended         Boolean                 @default(false)
  publishedAt           DateTime                @default(now())
  readUserCount         Int                     @default(0)
  shareCount            Int                     @default(0)
  status                PostStatus              @default(PUBLISHED)
  moderationStatus      PostModerationStatus    @default(APPROVED)
  moderationReason      String?
  matchedBannedWords    String?                 @db.Text
  reviewedAt            DateTime?
  reviewedById          String?
  rejectionReason       String?                 @db.Text
  summary               String?
  AdminAction           AdminAction[]
  PostModerationHistory PostModerationHistory[]
  Like                  Like[]
  Poll                  Poll?
  User                  User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ReviewedBy            User?                   @relation("PostReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  Board                 Board                   @relation(fields: [boardId], references: [id])
  PostFavorite          PostFavorite[]
  PostMedia             PostMedia[]
  PostTag               PostTag[]
  Reply                 Reply[]
  Report                Report[]
  stickerId             String?
  sticker               Sticker?                @relation("PostSticker", fields: [stickerId], references: [id], onDelete: SetNull)

  @@index([authorId, createdAt])
  @@index([authorId, profilePinnedAt, createdAt])
  @@index([boardId, createdAt])
  @@index([boardId, status, isDeleted, isPinned, isFeatured, createdAt], map: "Post_board_feed_idx")
  @@index([contentType])
  @@index([status, isDeleted, isPinned, isFeatured, createdAt], map: "Post_global_feed_idx")
  @@index([status, isDeleted, isPinned, isFeatured, likeCount, replyCount], map: "Post_hot_feed_idx")
  @@index([status, isDeleted, createdAt], map: "Post_trending_window_idx")
  @@index([isDeleted])
  @@index([isFeatured, createdAt])
  @@index([isPinned, createdAt])
  @@index([stickerId])
  @@index([isRecommended, createdAt])
  @@index([likeCount])
  @@index([replyCount])
  @@index([status])
  @@index([moderationStatus, createdAt])
}

/// Independent anonymous/light-social records for the Aspirin Clinic.
/// authorId is always retained for moderation; public DTOs intentionally do
/// not serialize it when identityMode is ANONYMOUS.
model ClinicRecord {
  id                 String               @id @default(cuid())
  authorId           String
  content            String               @db.Text
  category           ClinicCategory
  needType           ClinicNeedType
  identityMode       ClinicIdentityMode   @default(PUBLIC)
  anonymousNumber    Int
  status             ClinicContentStatus  @default(ACTIVE)
  aspirinCount       Int                  @default(0)
  consultationCount  Int                  @default(0)
  mouthpieceCount    Int                  @default(0)
  moderationReason   String?
  matchedBannedWords String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  author             User                 @relation("ClinicRecordAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  consultations      ClinicConsultation[] @relation("ClinicRecordConsultations")
  aspirins           ClinicAspirin[]      @relation("ClinicRecordAspirins")
  reports            ClinicReport[]       @relation("ClinicRecordReports")

  @@index([status, createdAt])
  @@index([category, status, createdAt])
  @@index([authorId, createdAt])
  @@index([consultationCount])
  @@index([aspirinCount])
}

model ClinicConsultation {
  id                 String               @id @default(cuid())
  recordId           String
  authorId           String
  content            String               @db.Text
  identityMode       ClinicIdentityMode   @default(PUBLIC)
  anonymousNumber    Int
  parentId           String?
  aspirinCount       Int                  @default(0)
  mouthpieceCount    Int                  @default(0)
  status             ClinicContentStatus  @default(ACTIVE)
  moderationReason   String?
  matchedBannedWords String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  record             ClinicRecord         @relation("ClinicRecordConsultations", fields: [recordId], references: [id], onDelete: Cascade)
  author             User                 @relation("ClinicConsultationAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent             ClinicConsultation?  @relation("ClinicConsultationThread", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies            ClinicConsultation[] @relation("ClinicConsultationThread")
  aspirins           ClinicAspirin[]      @relation("ClinicConsultationAspirins")
  mouthpieces        ClinicMouthpiece[]   @relation("ClinicConsultationMouthpieces")
  reports            ClinicReport[]       @relation("ClinicConsultationReports")

  @@index([recordId, status, createdAt])
  @@index([recordId, parentId, status, createdAt])
  @@index([authorId, createdAt])
  @@index([mouthpieceCount, createdAt])
}

model ClinicAspirin {
  id             String              @id @default(cuid())
  userId         String
  recordId       String?
  consultationId String?
  createdAt      DateTime            @default(now())
  user           User                @relation("ClinicAspirinUser", fields: [userId], references: [id], onDelete: Cascade)
  record         ClinicRecord?       @relation("ClinicRecordAspirins", fields: [recordId], references: [id], onDelete: Cascade)
  consultation   ClinicConsultation? @relation("ClinicConsultationAspirins", fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([userId, recordId])
  @@unique([userId, consultationId])
  @@index([recordId, createdAt])
  @@index([consultationId, createdAt])
}

model ClinicMouthpiece {
  id             String             @id @default(cuid())
  userId         String
  consultationId String
  createdAt      DateTime           @default(now())
  user           User               @relation("ClinicMouthpieceUser", fields: [userId], references: [id], onDelete: Cascade)
  consultation   ClinicConsultation @relation("ClinicConsultationMouthpieces", fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([userId, consultationId])
  @@index([consultationId, createdAt])
  @@index([userId, createdAt])
}

model ClinicReport {
  id             String              @id @default(cuid())
  reporterId     String
  recordId       String?
  consultationId String?
  reason         String
  detail         String?             @db.Text
  status         ReportStatus        @default(PENDING)
  handledById    String?
  handledAt      DateTime?
  createdAt      DateTime            @default(now())
  reporter       User                @relation("ClinicReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  record         ClinicRecord?       @relation("ClinicRecordReports", fields: [recordId], references: [id], onDelete: Cascade)
  consultation   ClinicConsultation? @relation("ClinicConsultationReports", fields: [consultationId], references: [id], onDelete: Cascade)
  handledBy      User?               @relation("ClinicReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([recordId, createdAt])
  @@index([consultationId, createdAt])
}

/// Immutable history for every post moderation cycle. Snapshot fields keep
/// the record useful even when the post or actor account is later removed.
model PostModerationHistory {
  id              String               @id @default(cuid())
  postId          String?
  actorId         String?
  actorName       String?
  actorUsername   String?
  actorUid        Int?
  action          String
  status          PostModerationStatus
  titleSnapshot   String?
  rejectionReason String?              @db.Text
  createdAt       DateTime             @default(now())
  Post            Post?                @relation(fields: [postId], references: [id], onDelete: SetNull)
  Actor           User?                @relation("PostModerationHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([status, createdAt])
  @@index([actorId, createdAt])
}

model PostFavorite {
  id        String   @id @default(cuid())
