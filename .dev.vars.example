NEXTJS_ENV=development
COOKIE_SECURE=false
PRISMA_USE_DRIVER_ADAPTER=true
HYPERDRIVE_DATABASE_URL=
PRISMA_POOL_MAX=1
PRISMA_POOL_MAX_USES=1
PRISMA_POOL_IDLE_TIMEOUT_MS=1000
PRISMA_POOL_CONNECTION_TIMEOUT_MS=2500
PRISMA_QUERY_TIMEOUT_MS=3500
PRISMA_STATEMENT_TIMEOUT_MS=3500
PRISMA_IDLE_TRANSACTION_TIMEOUT_MS=3500
PBKDF2_ITERATIONS=50000
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-64-character-random-secret
SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=eason-fans-club
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
