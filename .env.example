# Prisma / Supabase PostgreSQL
# Use Supabase Transaction Pooler for DATABASE_URL on Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Use the direct database connection for Prisma migrations.
DIRECT_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase Storage
# Use a public bucket for profile images so browsers can render the returned HTTPS URLs.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="eason-fans-club"

# Tencent Cloud COS private storage for E声猜歌 audio.
# Bucket must include the APPID suffix, for example: example-1250000000.
TENCENT_COS_SECRET_ID=""
TENCENT_COS_SECRET_KEY=""
TENCENT_COS_BUCKET=""
TENCENT_COS_REGION=""
TENCENT_COS_AUDIO_PREFIX="guess-song"
TENCENT_COS_SIGNED_URL_EXPIRES="90"

# Guess Song private media gateway. Keep disabled until the media server is configured.
GUESS_SONG_MEDIA_GATEWAY_ENABLED="false"
GUESS_SONG_MEDIA_GATEWAY_BASE_URL="https://media.ecfc.fans"
GUESS_SONG_MEDIA_TICKET_SECRET=""
GUESS_SONG_MEDIA_TICKET_EXPIRES="300"
MEDIA_GATEWAY_SECRET=""

TENCENT_COS_MUSIC_BUCKET=""
TENCENT_COS_MUSIC_REGION=""
MEDIA_PUBLIC_BASE_URL="https://media.ecfc.fans/media"

# Optional override. The bundled cross-platform FFmpeg binary is used when empty.
FFMPEG_PATH=""

# Auth
# Generate a long random value, for example: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"
ALLOW_REGISTER="true"

# Public site URL. Required for email verification links.
APP_URL="https://ecfc.fans"
NEXT_PUBLIC_APP_URL="https://ecfc.fans"

# Cloudflare Turnstile registration protection.
# Filing-period phone registration can keep this disabled; enable it after production domain is ready.
ENABLE_TURNSTILE="false"
NEXT_PUBLIC_ENABLE_TURNSTILE="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Email verification via Resend. Required in production when registrationMode=EMAIL or BOTH.
RESEND_API_KEY=""
EMAIL_FROM="EasonFansClub <noreply@ecfc.fans>"

# Tencent Cloud SES template for password reset links.
TENCENT_EMAIL_RESET_TEMPLATE_ID=""

# Cookies
# Set to true in HTTPS production deployments such as Vercel.
COOKIE_SECURE="true"

# Cloudflare Workers only. Keep false/empty on Vercel unless you intentionally want the pg driver adapter there.
# If a Cloudflare Hyperdrive connection string is exposed as an env var, it takes precedence over DATABASE_URL.
HYPERDRIVE_DATABASE_URL=""
PRISMA_USE_DRIVER_ADAPTER="false"
PRISMA_POOL_MAX="1"
PRISMA_POOL_MAX_USES="1"
PRISMA_POOL_IDLE_TIMEOUT_MS="1000"
PRISMA_POOL_CONNECTION_TIMEOUT_MS="2500"
PRISMA_QUERY_TIMEOUT_MS="3500"
PRISMA_STATEMENT_TIMEOUT_MS="3500"
PRISMA_IDLE_TRANSACTION_TIMEOUT_MS="3500"
PBKDF2_ITERATIONS="50000"
VERCEL_DB_TIMEOUT_MS="6000"

# Client IP trust boundary. Production Nginx must overwrite these headers;
# browser-supplied X-Forwarded-For/X-Real-IP are not trusted by the app.
# Production behind Cloudflare must use "cloudflare"; direct/local Nginx uses "nginx".
TRUSTED_CLIENT_IP_SOURCE="nginx"
TRUSTED_EDGE_GEO_HEADERS="false"
IP_DIAGNOSTICS_LOG="false"

# IP location provider. The default supports both IPv4 and IPv6. Results are
# cached by normalized IP in process memory and only the coarse label is stored.
IP_LOCATION_API_URL="https://ipapi.co/{ip}/json/"
IP_LOCATION_API_KEY=""
IP_LOCATION_TIMEOUT_MS="2500"
IP_LOCATION_CACHE_TTL_SECONDS="21600"

# 腾讯云邮件推送
TENCENT_EMAIL_REGION=ap-hongkong
TENCENT_EMAIL_FROM=0727@ecfc.fans
TENCENT_EMAIL_SECRET_ID=
TENCENT_EMAIL_SECRET_KEY=

# 注册验证码模板
TENCENT_EMAIL_REGISTER_TEMPLATE_ID=211023

# 密码重置模板
TENCENT_EMAIL_RESET_TEMPLATE_ID=211025
